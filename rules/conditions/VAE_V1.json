      "description": "Vaccine adverse event diagnosis or active problem, timeboxed when configured",
      "logic": {
        "any": [
          {
            "all": [
              {
                "any": [
                  { "predicate": "diagnosisInValueSet", "params": { "oid": "2.16.840.1.113762.1.4.1146.1605", "name": "Vaccine Adverse Event (Disorders) (SNOMED)" } },
                  { "predicate": "diagnosisInValueSet", "params": { "oid": "2.16.840.1.113762.1.4.1146.1604", "name": "Vaccine Adverse Event (Disorders) (ICD10CM)" } }
                ]
              },
              { "predicate": "withinTimebox", "params": {}, "gate": true }
            ]
          },
          {
            "all": [
              {
                "any": [
                  { "predicate": "problemInValueSet", "params": { "oid": "2.16.840.1.113762.1.4.1146.1605", "name": "Vaccine Adverse Event (Disorders) (SNOMED)", "status": "active" } },
