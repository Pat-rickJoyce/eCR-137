  "gaps": [
    {
      "valueSet": "Rule 2: Plague [Suspected] (Disorders) (ICD10CM)",
      "reason": "the authoritative Table 3 row is not implemented and has no codes; the code-less ICD10CM alternatives are omitted while the coded SNOMED alternatives remain operational"
    },
    {
      "valueSet": "Rule 6: four-fold or greater F1 antibody titer rise in paired acute and convalescent specimens",
      "reason": "the authoritative source marks this rule not implemented; SEM_V1 cannot compare paired specimens, collection intervals, or titer changes, so Rule 6 is omitted"
    },
    {
      "valueSet": "Rule 7: Yersinia pestis F1 antibody titer at least 1:128",
      "reason": "the authoritative source marks the titer threshold inoperable and its F1 quantitative test value set has no codes; SEM_V1 has no numeric/titer comparison, so Rule 7 is omitted"
    },
    {
      "valueSet": "Rules 8-10: laboratory test orders and code-less Plague test-panel/F1-antibody value sets",
      "reason": "SEM_V1 lab evidence does not distinguish orders from completed observations, so coded order-name alternatives use labTestInValueSet; Table 3 panel and F1-specific test sets have no codes and their branches are omitted"
    },
    {
      "valueSet": "Rules 11-12: clinical findings plus a plague epidemiologic link",
      "reason": "the authoritative source marks both logic sets inoperable because contact-with-case, animal-contact, and epizootic-area criteria are not implemented; SEM_V1 has no epidemiologic-link evidence, so the rules are omitted rather than allowing clinical findings alone to report"
    },
    {
      "valueSet": "Rule 13: Plague F1 antibody quantitative and qualitative test names",
      "reason": "the authoritative Table 3 rows have no codes; the code-less F1-specific branches are omitted while coded general antibody test alternatives remain operational"
    },
    {
      "valueSet": "Vital-records plague reporting",
      "reason": "the authoritative snapshot identifies this reporter type as not implemented in RCKMS, and SEM_V1 has no death-certificate cause/contributing-condition evidence"
    }
  ]
