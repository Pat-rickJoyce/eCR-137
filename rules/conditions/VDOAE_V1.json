    {
      "valueSet": "Rule 2 organism-specific Vaccinia culture test",
      "reason": "the source marks the Vaccinia-specific culture-test value set not implemented with no LOINC codes; VDOAE-R2 retains both implemented generic-test alternatives with same-observation Vaccinia results"
    },
    {
      "valueSet": "Rule 4 Vaccinia antigen detection",
      "reason": "the source marks the required antigen-test value set not implemented with no LOINC codes, so the wholly inoperable rule is omitted"
    },
    {
      "valueSet": "Rules 5-6 smallpox-vaccine administration status and encounter-relative timing",
      "reason": "SEM_V1 medication evidence identifies the CVX or RXNORM vaccine value set but cannot distinguish ordered or prescribed from administered status, and it has no medication-event dates with which to enforce administration within 21 days before the clinical encounter"
    },
    {
      "valueSet": "Rule 5 antigen alternative",
      "reason": "the source marks the Vaccinia antigen-test value set not implemented with no LOINC codes; VDOAE-R5 retains the implemented generic-culture and nucleic-acid alternatives"
    },
    {
      "valueSet": "Rule 6 measured body temperature",
      "reason": "SEM_V1 has no vital-sign numeric-threshold predicate; VDOAE-R6 retains the source's fever diagnosis and active-problem alternatives but cannot evaluate body temperature >=38 degC or >=100.4 degF"
    },
    {
      "valueSet": "Rule 6 missing ICD10CM clinical branches",
      "reason": "the source marks ICD10CM value sets for iritis, injection-site swelling, and injection-site pain not implemented with no codes; VDOAE-R6 retains their implemented SNOMED diagnosis and active-problem branches"
    },
    {
      "valueSet": "Rule 7 epidemiologic linkage",
      "reason": "the source marks both contact-with-Vaccinia and contact-with-recent-smallpox-vaccination criteria not implemented; SEM_V1 has no epidemiologic contact evidence, so the wholly inoperable rule is omitted"
    },
    {
