    },
    {
      "id": "TLI-R6",
      "description": "All results of interferon gamma release assays",
      "logic": {
        "predicate": "labTestInValueSet",
        "params": {
          "oid": "2.16.840.1.113762.1.4.1146.841",
          "name": "Tuberculosis (Interferon Gamma Release Assays)"
