      "id": "STSS-R1",
      "description": "Streptococcal toxic shock syndrome diagnosis or active problem, timeboxed when configured",
      "logic": {
        "any": [
          {
            "all": [
              { "predicate": "diagnosisInValueSet", "params": { "oid": "2.16.840.1.113762.1.4.1146.984", "name": "Streptococcal Toxic Shock Syndrome (Disorders) (SNOMED)" } },
              { "predicate": "withinTimebox", "params": {}, "gate": true }
            ]
          },
          {
            "all": [
              { "predicate": "problemInValueSet", "params": { "oid": "2.16.840.1.113762.1.4.1146.984", "name": "Streptococcal Toxic Shock Syndrome (Disorders) (SNOMED)", "status": "active" } },
              { "predicate": "withinTimebox", "params": {}, "gate": true }
            ]
          }
        ]
      }
    },
